# VR Meeting Room — Environment Variables
# Copy to .env. NEVER commit .env to git.

# NVIDIA NIM (for AI assistant)
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA CloudXR (optional — for VR headset streaming)
# Get CloudXR from: https://developer.nvidia.com/cloudxr-sdk
CLOUDXR_SERVER_URL=

# Service
VR_ROOM_PORT=7791
DEEPFLEX_BASE_URL=http://localhost:8000
